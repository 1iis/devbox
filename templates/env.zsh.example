# devbox local shell environment
#
# This file is copied once to:
#   /home/dev/.oh-my-zsh/custom/env.zsh
#
# host/sync.py creates it if missing and never overwrites existing content.
# It may contain local paths or secrets. Do not commit real env.zsh.

export NAME="Your Name"
export EMAIL="you@example.com"

# Optional local tool configuration.
# Prefer tool-native auth where practical, e.g. `gh auth login`.
# Prefer tool-native token source, e.g. `$(gh auth token)`
# export OPENAI_API_KEY=""
# export HETZNER_API_KEY=""
